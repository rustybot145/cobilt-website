# Copy to .env and fill in. .env is git-ignored.

# Where the site lives. Used to build the confirm link in emails.
BASE_URL=http://localhost:4321

# Supabase → Project Settings → API Keys / Data API
SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_…) or legacy anon key. Never the secret/service_role key.
SUPABASE_KEY=

# Resend → API Keys. Without it, confirm links are printed in the server log.
RESEND_API_KEY=
EMAIL_FROM="Cobilt <hello@getcobilt.app>"

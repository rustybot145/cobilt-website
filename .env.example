# Copy to .env and fill in. .env is git-ignored.

# Supabase → Project Settings → API Keys
SUPABASE_URL=https://your-project-ref.supabase.co
# Secret key (sb_secret_…). Server-only: never put it in browser code or share it.
SUPABASE_SECRET_KEY=

# Resend → API Keys (Sending access). Without it, codes are printed in the server log.
RESEND_API_KEY=
EMAIL_FROM="Cobilt <hello@getcobilt.app>"

# Set to 1 when deployed behind a host/proxy that sets X-Forwarded-For (most hosts do).
TRUST_PROXY=
